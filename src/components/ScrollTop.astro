<button type="button" class="k-scroll-top" aria-label="Back to top" transition:persist="k-scroll-top">
  <svg viewBox="0 0 48 48" aria-hidden="true">
    <circle class="k-scroll-track" cx="24" cy="24" r="20" />
    <circle class="k-scroll-bar" cx="24" cy="24" r="20" />
  </svg>
  <span>↑</span>
</button>

<script>
  const radius = 20;
  const circumference = 2 * Math.PI * radius;

  const updateProgress = () => {
    const scrollTop = document.querySelector<HTMLButtonElement>('.k-scroll-top');
    const scrollBar = document.querySelector<SVGCircleElement>('.k-scroll-bar');
    if (!scrollTop || !scrollBar) return;

    scrollBar.style.strokeDasharray = `${circumference}`;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const progress = max > 0 ? window.scrollY / max : 0;
    scrollBar.style.strokeDashoffset = `${circumference * (1 - progress)}`;
    scrollTop.classList.toggle('is-visible', window.scrollY > 240);
  };

  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement | null)?.closest('.k-scroll-top');
    if (!button) return;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  window.addEventListener('scroll', updateProgress, { passive: true });
  document.addEventListener('astro:page-load', updateProgress);
  updateProgress();
</script>
