---
export type FeatureItem = {
  title: string;
  text?: string;
  href?: string;
};

interface Props {
  kicker?: string;
  title: string;
  items: FeatureItem[];
  columns?: 3 | 4;
}

const { kicker = 'Details', title, items, columns = 4 } = Astro.props;
---

<section class="k-features">
  <div class="k-wrap">
    <p class="k-kicker k-kicker-dark">{kicker}</p>
    <h2 class="k-features-title">{title}</h2>
    {
      Astro.slots.has('default') && (
        <div class="k-works-lead">
          <slot />
        </div>
      )
    }
    <ol class:list={['k-feature-board', columns === 3 && 'is-3']}>
      {
        items.map((item, index) => (
          <li>
            {
              item.href ? (
                <a class="k-feature-card" href={item.href}>
                  <span class="k-feature-index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <h3>{item.title}</h3>
                  {item.text && <p>{item.text}</p>}
                </a>
              ) : (
                <article class="k-feature-card">
                  <span class="k-feature-index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <h3>{item.title}</h3>
                  {item.text && <p>{item.text}</p>}
                </article>
              )
            }
          </li>
        ))
      }
    </ol>
  </div>
</section>
