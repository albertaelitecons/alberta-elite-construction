---
import { site } from '../data/site';
import { locationLinks } from '../data/locations';

interface Props {
  /** Optional Google Maps embed URL; defaults to the site-wide map. */
  mapSrc?: string;
  mapReferrerPolicy?: 'no-referrer-when-downgrade' | 'strict-origin-when-cross-origin';
}

const { mapSrc = site.mapEmbed, mapReferrerPolicy = 'no-referrer-when-downgrade' } = Astro.props;
---

<section class="k-locations" id="locations">
  <div class="k-wrap">
    <div class="k-locations-body">
      <div class="k-locations-copy">
        <p class="k-kicker k-kicker-dark">Locations</p>
        <h2>Serving Calgary & Surrounding Communities<br />for more than 15 years</h2>
        <p class="k-locations-lead">
          We provide construction and renovation services throughout Calgary and the surrounding
          areas, helping homeowners improve the spaces they use every day.
        </p>
        <p class="k-locations-lead">
          From kitchens and bathrooms to basements, garages, decks, fences, roofs, and
          surveillance, our team works across the region on projects of all sizes.
        </p>
        <ul class="k-locations-grid">
          {
            locationLinks.map((place) => (
              <li>
                <a href={place.href}>{place.name}</a>
              </li>
            ))
          }
        </ul>
        <a class="k-text-link" href={site.mapUrl} target="_blank" rel="noreferrer">
          View us on Google Maps
        </a>
      </div>
      <div class="k-locations-map">
        <iframe
          title="Alberta Elite Construction on Google Maps"
          src={mapSrc}
          loading="lazy"
          referrerpolicy={mapReferrerPolicy}
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>
