---
import type { BlogPost } from '../data/blog';
import { blogPostHref, formatBlogDate } from '../data/blog';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

<div class="k-blog-list">
  {
    posts.map((post) => (
      <article>
        <a class="k-blog-card-link" href={blogPostHref(post.slug)}>
          <p class="k-kicker">{post.categoryLabel}</p>
          <h2>{post.title}</h2>
          <time datetime={post.date}>{formatBlogDate(post.date)}</time>
          <p>{post.excerpt}</p>
          <span>Read article</span>
        </a>
      </article>
    ))
  }
</div>
