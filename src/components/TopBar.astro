---
import { site } from '../data/site';
---

<div class="border-b border-[#ececec] bg-white text-[13px] text-[#777]">
  <div
    class="mx-auto flex max-w-[1200px] flex-col items-center justify-between gap-2 px-5 py-2.5 md:flex-row lg:px-8"
  >
    <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-1">
      <li>
        <a href={site.phoneHref} class="inline-flex items-center gap-2 transition hover:text-brand">
          <svg class="h-3.5 w-3.5 text-brand" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.3 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.4 21 3 13.6 3 4.5 3 3.9 3.4 3.5 4 3.5H7c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1L6.6 10.8z" />
          </svg>
          {site.phoneDisplay}
        </a>
      </li>
      <li>
        <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 transition hover:text-brand">
          <svg class="h-3.5 w-3.5 text-brand" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5L4 8V6l8 5 8-5v2z" />
          </svg>
          {site.email}
        </a>
      </li>
      <li class="inline-flex items-center gap-2">
        <svg class="h-3.5 w-3.5 text-brand" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 11h-4V7h2v4h2v2z" />
        </svg>
        {site.hours.display}
      </li>
    </ul>
    <a
      href={site.mapUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 transition hover:text-brand"
    >
      <svg class="h-3.5 w-3.5 text-brand" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" />
      </svg>
      {site.address.city}, {site.address.region}
    </a>
  </div>
</div>
