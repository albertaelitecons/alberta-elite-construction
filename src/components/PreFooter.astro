---
import { site } from '../data/site';
---

<div class="border-t border-white/10 bg-charcoal-light">
  <div class="mx-auto grid max-w-7xl divide-y divide-white/10 md:grid-cols-3 md:divide-x md:divide-y-0">
    <div class="flex flex-col items-center gap-2 px-6 py-8 text-center">
      <span class="font-display text-3xl font-bold text-brand">☎</span>
      <p class="text-xs font-bold uppercase tracking-widest text-white/60">Call us</p>
      <a href={site.phoneHref} class="text-lg font-bold text-white hover:text-brand">{site.phoneDisplay}</a>
    </div>
    <div class="flex flex-col items-center gap-2 px-6 py-8 text-center">
      <span class="font-display text-3xl font-bold text-brand">✉</span>
      <p class="text-xs font-bold uppercase tracking-widest text-white/60">Email us</p>
      <a href={`mailto:${site.email}`} class="text-lg font-bold text-white hover:text-brand">
        {site.email}
      </a>
    </div>
    <div class="flex flex-col items-center gap-2 px-6 py-8 text-center">
      <span class="font-display text-3xl font-bold text-brand">◷</span>
      <p class="text-xs font-bold uppercase tracking-widest text-white/60">Opening time</p>
      <p class="text-lg font-bold text-white">{site.hours.display}</p>
    </div>
  </div>
</div>
