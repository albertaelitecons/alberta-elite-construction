---
import '../styles/global.css';
import { site } from '../data/site';
import { breadcrumbsForPath, type Crumb } from '../data/seo';
import { buildPageGraph } from '../data/schema';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import ScrollTop from '../components/ScrollTop.astro';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
  ogImageAlt?: string;
  heroImage?: string;
  bodyClass?: string;
  noIndex?: boolean;
  preloadHero?: boolean;
  pageType?: 'website' | 'article';
  datePublished?: string;
  dateModified?: string;
  breadcrumbs?: Crumb[];
}

const {
  title = site.title,
  description = site.description,
  path = '/',
  ogImage = '/images/hero/hero-living-room.jpg',
  ogImageAlt = 'Alberta Elite Construction remodeling project in Calgary',
  heroImage,
  bodyClass,
  noIndex = false,
  preloadHero,
  pageType = 'website',
  datePublished,
  dateModified,
  breadcrumbs,
} = Astro.props;

const canonical = new URL(path, site.url).href;
const crumbs = breadcrumbs ?? breadcrumbsForPath(path, title);
const schema = buildPageGraph({
  canonical,
  title,
  description,
  path,
  ogImage,
  breadcrumbs: crumbs,
  datePublished,
  dateModified,
  pageType,
});
---

<!doctype html>
<html lang="en-CA">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      heroImage={heroImage ?? ogImage}
      noIndex={noIndex}
      preloadHero={preloadHero ?? !noIndex}
      type={pageType}
      datePublished={datePublished}
      dateModified={dateModified}
    />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class:list={['kitchor-home', bodyClass]}>
    <SiteHeader currentPath={path} overlay />
    <main>
      <slot />
    </main>
    <Footer />
    <ScrollTop />
  </body>
</html>
